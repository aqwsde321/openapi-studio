#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"
head_oid=$(git rev-parse HEAD)
needs_tests=0
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in
    *[!0]*) ;;
    *) continue ;;
  esac
  commit_oid=$(git rev-parse "${local_oid}^{commit}")
  if [ "$commit_oid" != "$head_oid" ]; then
    echo "push할 커밋을 checkout한 뒤 다시 실행하세요: $local_ref" >&2
    exit 1
  fi
  needs_tests=1
done
[ "$needs_tests" -eq 1 ] || exit 0

check_source() {
  if [ "$(git rev-parse HEAD)" != "$head_oid" ] ||
     ! git diff --quiet HEAD -- ||
     ! git diff --cached --quiet ||
     [ -n "$(git ls-files --others --exclude-standard)" ]; then
    echo "push할 커밋과 테스트 소스가 달라졌습니다. 변경 사항을 커밋하거나 치운 뒤 다시 push하세요." >&2
    exit 1
  fi
}
check_source
echo "push 전 빌드와 E2E를 실행합니다."
npm run build </dev/null
# Use a fresh test server on a separate port from the development server.
CI=1 OPENAPI_STUDIO_E2E_PORT=5185 npm run test:e2e </dev/null
check_source
